# Public site URL (used for SEO, sitemap, Open Graph, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://www.essemdigital.com

# Search engine verification (optional — add after registering in Search Console / Bing Webmaster)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code
# NEXT_PUBLIC_BING_SITE_VERIFICATION=your-bing-verification-code

# Contact form — Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=ESSEM Website <hello@yourdomain.com>
CONTACT_EMAIL=contact@essemdigital.com

# Newsletter — set NEWSLETTER_PROVIDER to brevo, mailchimp, or convertkit
# Subscribers must tick the marketing consent checkbox; consent date/source are stored in your CRM.
# NEWSLETTER_PROVIDER=brevo
# BREVO_API_KEY=your-brevo-api-key
# BREVO_LIST_ID=2
# Optional: create Brevo contact attributes MARKETING_CONSENT, CONSENT_DATE, CONSENT_SOURCE, CONSENT_TEXT

# NEWSLETTER_PROVIDER=mailchimp
# MAILCHIMP_API_KEY=your-mailchimp-api-key
# MAILCHIMP_SERVER_PREFIX=us21
# MAILCHIMP_LIST_ID=your-list-id

# NEWSLETTER_PROVIDER=convertkit
# CONVERTKIT_API_KEY=your-convertkit-api-key
# CONVERTKIT_FORM_ID=your-form-id
